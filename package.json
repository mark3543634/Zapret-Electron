{
  "name": "zapret-pro",
  "version": "7.2.1",
  "description": "Удобный Windows-интерфейс с автоматическим выбором из Zapret, ByeDPI, DPIBreak, GoodbyeDPI и GreenTunnel, отдельным защищённым DNS и Telegram WS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-packager . ZapretPro --executable-name=\"Zapret Electron\" --platform=win32 --arch=x64 --icon=icon.ico --out=out --overwrite --ignore=\"(^/out(?:$|-)|^/desktop-test-v|^/ZapretPro-win32-x64$|^/releases$|^/tools$|^/\\.vendor-staging|^/icon-minimal.*)\" && node set-admin-manifest.js"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-packager": "^17.1.2",
    "rcedit": "^3.1.0"
  }
}

{
  "name": "zapret-pro",
  "version": "6.7.0",
  "description": "GUI для обхода DPI-блокировок на Windows с безопасными обновлениями и резервами Telegram-прокси",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-packager . ZapretPro --executable-name=\"Zapret Electron\" --platform=win32 --arch=x64 --icon=icon.ico --out=out --overwrite --ignore=\"(^/out$|^/ZapretPro-win32-x64$|^/releases$|^/icon-minimal.*)\" && node set-admin-manifest.js"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-packager": "^17.1.2",
    "rcedit": "^3.1.0"
  }
}
